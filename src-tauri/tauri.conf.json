{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PIKIPIKI LAUNCHER",
  "version": "0.1.2",
  "identifier": "com.pikipiki.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PIKIPIKI LAUNCHER",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost https://*.mojang.com https://*.minecraft.net data:; connect-src 'self' https://*.mojang.com https://*.minecraft.net https://*.adoptium.net https://api.adoptium.net https://*.modrinth.com https://github.com https://*.githubusercontent.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGNjUzRjc4ODlEQjdDOUQKUldTZGZOdUplRDlsdnc2Ti85Y2svOWxudUtnWEtTemNhRlJ4K2NzZVdCU09RUWRXME9xaFFyZzgK",
      "endpoints": [
        "https://github.com/AxelRGDiaz/launcher-mine/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Spanish", "English"]
      }
    },
    "resources": ["../config/config.default.json", "../config/themes/*"]
  }
}
